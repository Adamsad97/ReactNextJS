// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id               String     @id @default(uuid())
  name             String
  email            String     @unique
  password         String
  tasks            Task[]
  categories       Category[] @relation("CategoryOwner")
  sharedCategories Category[] @relation("CategoryMembers")
  assignedTasks    Task[]     @relation("TaskAssignees")
  createdAt        DateTime   @default(now())
  projectInvitations ProjectInvitation[]
  resetToken       String?    @unique
  resetTokenExpires DateTime?
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      Status    @default(TODO)
  priority    Priority  @default(MEDIUM)
  deadline    DateTime?
  position    Int
  userId      String
  categoryId  String?
  user        User      @relation(fields: [userId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  assignees   User[]    @relation("TaskAssignees")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id      String  @id @default(uuid())
  name    String
  color   String?
  userId  String
  tasks   Task[]
  user    User    @relation("CategoryOwner", fields: [userId], references: [id])
  members User[]  @relation("CategoryMembers")
  invitations ProjectInvitation[]
}

model ProjectInvitation {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([categoryId, userId])
}
